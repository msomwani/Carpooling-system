# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carpool_user:your_postgres_password@localhost:5432/carpooling_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_strong_random_secret

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Enable: Maps JavaScript API + Places API in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Google OAuth (Sign in with Google) ──────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── AWS SES (Email / OTP sending) ───────────────────────────────────────────
# Found at: AWS Console → Amazon SES → SMTP Settings → Create SMTP Credentials
SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_ses_smtp_username
SMTP_PASSWORD=your_ses_smtp_password

# From address shown to email recipients (must be verified in SES)
SMTP_FROM_EMAIL=noreply@yourdomain.com

# How long OTP codes are valid (default: 10 minutes)
OTP_EXPIRY_MINUTES=10
