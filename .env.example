# Copy this file to .env and replace with your own values.
# Never commit the real .env file.

POSTGRES_DB=carpooling
POSTGRES_USER=carpool_user
POSTGRES_PASSWORD=change_me_postgres

JWT_SECRET=change_me_jwt_secret

# Internal service defaults for docker-compose
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Browser client origins allowed for CORS (comma-separated, no spaces)
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]'
